# DecisionMachines3000 environment schema.
# Secrets are loaded from 1Password through the desktop app integration, so no
# service account token is needed for local development. Sign in to the
# 1Password desktop app and enable its CLI integration before running `vp dev`.
#
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=my.1password.com)
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# ---

# The type on each key below makes the load fail on a value the Worker would treat
# as "no key": a blank or whitespace-only value, or the word `unset` in any case with
# surrounding whitespace. It mirrors `isKeySet` in worker/env.ts (`value.trim() !== ""`
# and not `isPlaceholder`, which is `value.trim().toLowerCase() === "unset"`). A key
# whose field is missing has no value, so the type is not applied and the key stays
# optional. Keep the two rules in step.

# API key for TypeSafe, used only by the server, in `POST /api/decide/typesafe`.
# Stored in the "Jev" item of the 1Password "dev" vault.
# @optional @sensitive
# @type=string(matches=regex("^(?!\s*(unset)?\s*$)", "i"))
# @docs(https://docs.typesafe.ai/api.md)
TYPESAFE_API_KEY=op(op://dev/nocajwa573emc6ko6sv5bkn6y4/TYPESAFE_API_KEY, allowMissing=true)

# API key for SubQ, used only by the server, in `POST /api/decide/subq`.
# @optional @sensitive
# @type=string(matches=regex("^(?!\s*(unset)?\s*$)", "i"))
SUBQ_API_KEY=op(op://dev/nocajwa573emc6ko6sv5bkn6y4/SUBQ_API_KEY, allowMissing=true)

# API key for OpenAI, used only by the server, in `POST /api/decide/openai`.
# @optional @sensitive
# @type=string(matches=regex("^(?!\s*(unset)?\s*$)", "i"))
OPENAI_API_KEY=op(op://dev/nocajwa573emc6ko6sv5bkn6y4/OPENAI_API_KEY, allowMissing=true)

# Fails the load when none of the three keys has a value. Not a secret: it holds
# the word `ok` and is uploaded to the Worker as a plain variable.
# @required @sensitive=false
AT_LEAST_ONE_PROVIDER_KEY=if(isEmpty(fallback($TYPESAFE_API_KEY, $SUBQ_API_KEY, $OPENAI_API_KEY)), "", ok)
