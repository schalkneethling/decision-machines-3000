{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    /* ESNext.TypedArrays declares Uint8Array.prototype.toBase64: the Node dev host compiles worker/multipart.ts, which checks for it. */
    "lib": ["ES2023", "DOM", "ESNext.TypedArrays"],
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type checking */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "server", "vite.config.ts", "env.d.ts"]
}
