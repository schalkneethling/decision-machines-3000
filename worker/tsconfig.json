{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    /* No DOM: the Workers runtime types in worker-configuration.d.ts declare the globals. */
    /* ESNext.TypedArrays declares Uint8Array.prototype.toBase64, which workerd implements. */
    "lib": ["ES2024", "ESNext.TypedArrays"],
    /* Generated by `vp exec wrangler types worker/worker-configuration.d.ts`. */
    "types": ["./worker-configuration.d.ts"],
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting, matching the root tsconfig */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts"]
}
