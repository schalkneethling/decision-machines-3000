// Spike configuration for the DecisionMachines3000 Worker (issue #1).
// Every key is checked against node_modules/wrangler/config-schema.json.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decisionmachines3000",
  "main": "./worker/index.ts",
  // The newest date the installed workerd (1.20261006.1) supports. Dates from
  // 2026-08-04 turn on nodejs_compat by default, so no compatibility_flags are needed.
  "compatibility_date": "2026-10-06",
  "assets": {
    // Where `vp run build` writes the client. @cloudflare/vite-plugin sets this itself
    // in the built config; plain `wrangler dev` reads it from here.
    "directory": "./dist/client",
    // Requests under /api/ always reach the Worker, so an unknown API path gets the
    // Worker's JSON 404 instead of the single-page-app fallback below.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
}
